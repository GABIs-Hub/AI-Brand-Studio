rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /brands/{brandId} {
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || !('userId' in request.resource.data));
      allow read, update, delete: if request.auth != null && (!('userId' in resource.data) || resource.data.userId == request.auth.uid || resource.data.userId == null || resource.data.userId == "");
    }
  }
}
