# ==============================================================================
# ANTHROPIC (CLAUDE) MODELS & CONFIGURATION
# ==============================================================================
ANTHROPIC_API_KEY=
# Primary / Strategic Reasoning Model (deep brand positioning, narrative, and architecture)
# Recommended: claude-3-7-sonnet-20250219 | claude-3-5-sonnet-latest | claude-sonnet-4-5 | claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
# Fast / High-Throughput Model (for agile sprints, social copy, and low-latency chat)
# Recommended: claude-3-5-haiku-latest | claude-3-5-haiku-20241022 | claude-3-haiku-20240307
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
# Comma-separated list of fallback models tried sequentially if primary model hits rate-limits (429) or is overloaded (503)
ANTHROPIC_FALLBACK_MODELS=claude-3-7-sonnet-20250219,claude-3-5-sonnet-latest,claude-3-5-haiku-latest

# ==============================================================================
# OPENAI MODELS & CONFIGURATION
# ==============================================================================
OPENAI_API_KEY=
# Primary Flagship Text Model (comprehensive brand strategy, mission, and identity)
# Recommended: gpt-4o | gpt-4o-2024-11-20 | gpt-4.5-preview | gpt-4-turbo
OPENAI_MODEL=gpt-4o
# Fast / High-Throughput Model (for quick iterations, naming sprints, and lite mode)
# Recommended: gpt-4o-mini | gpt-3.5-turbo
OPENAI_FAST_MODEL=gpt-4o-mini
# Deep Reasoning Model (for complex market analysis, rebrand diagnostics, and strategy)
# Recommended: o3-mini | o1 | o1-mini | o1-preview
OPENAI_REASONING_MODEL=o3-mini
# Comma-separated list of fallback models tried sequentially if primary model is unavailable
OPENAI_FALLBACK_MODELS=gpt-4o,gpt-4o-mini,o3-mini,gpt-4-turbo
# Image Generation Models
# Recommended: dall-e-3 | gpt-image-1 | dall-e-2
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_FALLBACK_MODELS=dall-e-3,dall-e-2

# ==============================================================================
# GOOGLE GEMINI MODELS & CONFIGURATION
# ==============================================================================
GEMINI_API_KEY=
# Primary / Pro Strategic Model
# Recommended: gemini-2.5-pro | gemini-3.7-flash | gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-pro
# Fast / High-Speed Model
# Recommended: gemini-2.5-flash | gemini-3.1-flash-lite | gemini-2.0-flash | gemini-flash-latest
GEMINI_FAST_MODEL=gemini-2.5-flash
# Comma-separated fallback chain
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.7-flash,gemini-2.5-pro,gemini-2.0-flash,gemini-flash-latest
# Image Generation Models
# Recommended: gemini-3.1-flash-image | gemini-3.1-flash-lite-image | imagen-3.0-generate-002
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_FALLBACK_MODELS=gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# ==============================================================================
# HIGGSFIELD & DIFFUSION MODELS
# ==============================================================================
HF_CREDENTIALS=
# Primary text-to-image / 3D mockup endpoint
HIGGSFIELD_ENDPOINT=flux-pro/kontext/max/text-to-image
# Fallback endpoints tried if primary is busy
HIGGSFIELD_FALLBACK_ENDPOINTS=flux-pro/kontext/max/text-to-image,flux-pro/v1.1,flux-dev

# ==============================================================================
# DATABASE & AUTHENTICATION
# ==============================================================================
AUTH_SECRET=
DATABASE_URL="<your postgresql:// connection string from neon.tech>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TRUST_PROXY=

# ==============================================================================
# CLOUDFLARE R2 STORAGE (Brand Assets, Exports & Mockups)
# ==============================================================================
R2_ACCESS_KEY_ID=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_SECRET_ACCESS_KEY=

# ==============================================================================
# RESEND EMAIL SERVICE
# ==============================================================================
RESEND_API_KEY=
RESEND_FROM=