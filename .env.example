# ── Server ────────────────────────────────────────────────────────────────
# APP_URL is used for the same-origin API guard and for links inside emails
# (verification / password reset). Defaults to http://localhost:3000.
APP_URL="http://localhost:3000"
# TRUST_PROXY="1": set when deployed behind a hosting proxy (Render/Fly/Railway)
# so req.ip (rate limiting) and protocol detection (secure cookies) see the client.
TRUST_PROXY="0"

# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Required for accounts (email/password + Google) and cloud brand sync.
# Create a project at neon.tech and copy the connection string.
DATABASE_URL="<your postgresql:// connection string from neon.tech>"

# ── Auth.js ───────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="<output of: openssl rand -base64 32>"

# Google OAuth (optional — email/password works without it).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="<your google oauth client id>"
GOOGLE_CLIENT_SECRET="<your google oauth client secret>"

# ── Transactional email (Resend, optional — email verification & password reset) ──
# With no key configured, verification/reset links print to the server console
# instead (full flow still works locally). Create a key at resend.com; RESEND_FROM
# must be a verified sender (or onboarding@resend.dev for testing your own inbox).
RESEND_API_KEY="<your resend api key>"
RESEND_FROM="GABI <onboarding@resend.dev>"

# ── AI Providers (all optional — each configured provider is added to the
#    fallback cascade; with none configured, the app uses its procedural
#    offline generators) ───────────────────────────────────────────────────
# Model LADDERS: the gateway tries the strongest model first and steps DOWN
# the ladder when a model is quota-limited or busy, so a small request never
# waits behind a flagship model. Task tiers: /api/generate-brand runs 'max'
# (whole ladder, larger token budget); chat runs 'lite' (cheapest rung);
# everything else 'standard'. Comma-separate overrides, strongest first.
# The legacy singular overrides (OPENAI_MODEL / ANTHROPIC_MODEL) still work:
# they pin their model to the front of the ladder.

# Google Gemini (text + images)
GEMINI_API_KEY=""
# Optional ladder override (default: gemini-3.7-flash, gemini-3.1-flash-lite, gemini-flash-latest):
GEMINI_TEXT_MODELS=""
# Optional image ladder override (default: gemini-3.1-flash-image, gemini-3.1-flash-lite-image):
GEMINI_IMAGE_MODELS=""

# OpenAI / ChatGPT (text + gpt-image-1 images)
OPENAI_API_KEY=""
# Optional ladder override (default: gpt-5.6-astra, gpt-4o, gpt-4o-mini):
OPENAI_TEXT_MODELS=""
# Legacy singular override — pins its model to the front of the ladder:
OPENAI_MODEL=""
# Optional image model override (default: gpt-image-1):
OPENAI_IMAGE_MODEL="gpt-image-1"

# Anthropic Claude (text)
ANTHROPIC_API_KEY=""
# Optional ladder override (default: claude-fable-5.1, claude-sonnet-4-5, claude-3-5-haiku-latest):
ANTHROPIC_TEXT_MODELS=""
# Legacy singular override — pins its model to the front of the ladder:
ANTHROPIC_MODEL=""
