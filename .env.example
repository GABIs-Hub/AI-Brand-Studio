# ── Server ────────────────────────────────────────────────────────────────
# APP_URL is used for the same-origin API guard and for links inside emails
# (verification / password reset). Defaults to http://localhost:3000.
APP_URL="http://localhost:3000"
# TRUST_PROXY="1": set when deployed behind a hosting proxy (Render/Fly/Railway)
# so req.ip (rate limiting) and protocol detection (secure cookies) see the client.
TRUST_PROXY="0"

# ── Database (Neon Postgres) ─────────────────────────────────────────────
# Required for accounts (email/password + Google) and cloud brand sync.
# Create a project at neon.tech and copy the connection string.
DATABASE_URL="<your postgresql:// connection string from neon.tech>"

# ── Auth.js ───────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET="<output of: openssl rand -base64 32>"

# Google OAuth (optional — email/password works without it).
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID="<your google oauth client id>"
GOOGLE_CLIENT_SECRET="<your google oauth client secret>"

# ── Transactional email (Resend, optional — email verification & password reset) ──
# With no key configured, verification/reset links print to the server console
# instead (full flow still works locally). Create a key at resend.com; RESEND_FROM
# must be a verified sender (or onboarding@resend.dev for testing your own inbox).
RESEND_API_KEY="<your resend api key>"
RESEND_FROM="GABI <onboarding@resend.dev>"

# ── AI Providers (all optional — each configured provider is added to the
#    fallback cascade; with none configured, the app uses its procedural
#    offline generators) ───────────────────────────────────────────────────
# Google Gemini (text + images)
GEMINI_API_KEY=""

# OpenAI / ChatGPT (text + gpt-image-1 images)
OPENAI_API_KEY=""
# Optional model overrides:
OPENAI_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="gpt-image-1"

# Anthropic Claude (text)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Higgsfield (image generation via Flux-class models; KEY_ID:KEY_SECRET)
HF_CREDENTIALS=""
# Optional endpoint override:
HIGGSFIELD_ENDPOINT="flux-pro/kontext/max/text-to-image"

# ── Image storage (Cloudflare R2, optional) ───────────────────────────────
# Used to persist AI-rendered images for signed-in users. Without it, renders
# stay session-only in the browser.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional: public base URL for your bucket (e.g. https://cdn.yourbrand.com).
# When empty, presigned URLs are generated instead.
R2_PUBLIC_BASE_URL=""